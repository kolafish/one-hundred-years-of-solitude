page {
  background: #f4ebd9;
  color: #2c1e16;
}

.game {
  box-sizing: border-box;
  width: 100%;
  max-width: 540px;
  margin: 0 auto;
  padding: 22rpx 24rpx 56rpx;
}

.ending-actions,
.notice,
.game-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.toolbar {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.toolbar .control {
  width: 100%;
  padding: 0 6rpx;
  white-space: nowrap;
}

.wait-control { grid-column: 1 / -1; }

.turn {
  color: #673f27;
  font-size: 26rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 44px;
  margin: 0;
  border: 1rpx solid #a87b4a;
  border-radius: 14rpx;
  padding: 0 14rpx;
  background: #ead8b8;
  color: #56351f;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
  transition: transform 150ms ease;
}

.ui-icon-xs {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.ui-icon-sm {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.ui-icon-md {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.skill-icon-img {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.control::after {
  border: 0;
}

.control[disabled] {
  color: #756557;
  opacity: 0.65;
}

.primary {
  background: #82401d;
  color: #fff7e8;
}

.pressed {
  transform: scale(0.96);
}

.board-frame {
  overflow: hidden;
  border: 2rpx solid #5c3a21;
  border-radius: 16rpx;
  background: #e9dcc3;
}

.game-meta {
  justify-content: space-between;
  min-height: 44px;
  margin: 0 0 14rpx;
}

.game-meta .board-caption { margin: 0; }
.game-meta .sound-toggle {
  flex: none;
  width: 74px;
  max-width: 74px;
  margin: 0;
  padding: 0 8rpx;
}

.board {
  position: relative;
  height: 0;
}

.board-canvas,
.hit-grid {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hit-grid {
  display: flex;
  flex-direction: column;
}

.hit-row {
  display: flex;
  flex: 1;
}

.hit-tile {
  flex: 1;
}

.board-caption {
  margin: 14rpx 0;
  color: #654a35;
  font-size: 25rpx;
  line-height: 1.5;
}

.board-banner {
  position: absolute;
  z-index: 1;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  background: rgba(58, 39, 28, 0.92);
  color: #fff4df;
  font-size: 23rpx;
  line-height: 1.35;
  pointer-events: none;
}

.board-controls { height: 44px; margin: 0 0 16rpx; }

.board-action-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44px;
}

.board-action-row .control { flex: none; width: auto; white-space: nowrap; }
.board-action-row .board-caption { margin: 0; }

.board-gesture-hint { text-align: center; }

.panel {
  margin-bottom: 20rpx;
  border: 1rpx solid #d1b48b;
  border-radius: 18rpx;
  padding: 20rpx;
  background: #faf1e0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.notice {
  justify-content: space-between;
}

.hints text,
.ending-description {
  display: block;
  margin-top: 8rpx;
  color: #5c4332;
  font-size: 27rpx;
  line-height: 1.55;
}

.ending-actions {
  margin-top: 16rpx;
}

.hint-next {
  margin-top: 12rpx;
}

.skill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  border: 1rpx solid #d1b48b;
  border-radius: 12rpx;
  padding: 12rpx;
  background: #eee0c6;
}

.skill-active {
  border-color: #9e2a2b;
  background: #fff6e6;
}

.skill-icon {
  font-size: 34rpx;
}

.skill-copy {
  flex: 1;
  min-width: 0;
}

.skill-title {
  font-size: 25rpx;
  font-weight: 700;
}

.skill-description {
  margin-top: 4rpx;
  color: #5c4332;
  font-size: 23rpx;
  line-height: 1.45;
}

.badge,
.skill-button {
  flex-shrink: 0;
  font-size: 24rpx;
}

.skill-state {
  flex: 0 0 148rpx;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.skill-state .skill-button { width: 100%; padding: 0 6rpx; white-space: nowrap; }

.badge {
  border-radius: 8rpx;
  padding: 8rpx 10rpx;
  background: #dec9a5;
  color: #5c4332;
}

.shield {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #f2d7a3;
  color: #6a3c16;
}

.chronicle-log { height: 356rpx; }

.log {
  border-bottom: 1rpx solid #e0c9a8;
  padding: 10rpx 0;
  color: #5c4332;
  font-size: 25rpx;
  line-height: 1.6;
}

.log-highlight,
.log-character {
  color: #794315;
  font-weight: 600;
}

.log-danger {
  color: #9e2a2b;
}

.log-turn {
  margin-right: 10rpx;
  border-radius: 6rpx;
  padding: 2rpx 6rpx;
  background: #ead8b8;
  color: #5c4332;
  font-variant-numeric: tabular-nums;
}

.act-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.act-subtitle {
  margin-bottom: 16rpx;
  color: #63432f;
  font-size: 28rpx;
  line-height: 1.5;
}

.act-button {
  flex: 1 1 0;
  width: auto;
  min-width: 44px;
  white-space: nowrap;
  padding-inline: 8rpx;
  font-size: 25rpx;
}

.act-current {
  border-color: #9e2a2b;
  background: #f7eacb;
}

.loadout-overlay {
  position: fixed;
  z-index: 3;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(30, 20, 13, 0.65);
}

.loadout-sheet {
  box-sizing: border-box;
  width: 100%;
  max-width: 540px;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #faf1e0;
}

.loadout-choices {
  height: 36vh;
}

.loadout-choice {
  width: 100%;
  justify-content: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
  padding: 12rpx;
  text-align: left;
}

.board-help {
  padding: 14rpx 18rpx;
  color: #5c4332;
  font-size: 25rpx;
  line-height: 1.55;
}

.tile-inspector {
  box-sizing: border-box;
  height: 148rpx;
  padding: 0;
}

.inspector-content > view + view {
  margin-top: 6rpx;
}

.help-name {
  color: #2c1e16;
  font-weight: 700;
}

.board-legend { margin-bottom: 16rpx; }

.legend-scroll {
  box-sizing: border-box;
  height: 500rpx;
  margin-top: 10rpx;
  margin-bottom: 0;
  padding: 0;
}

.board-legend > .control {
  width: auto;
  max-width: 10rem;
  margin-left: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.legend-item + .legend-item {
  margin-top: 8rpx;
}

.legend-icon {
  position: relative;
  overflow: hidden;
  width: 62rpx;
  height: 62rpx;
  flex: none;
  border-radius: 8rpx;
}

.legend-icon image {
  position: absolute;
  width: 600%;
  height: 500%;
}
