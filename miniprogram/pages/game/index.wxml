<view class="game">
  <view class="act-subtitle">{{level.subtitle}}</view>
  <view class="act-nav" aria-label="马孔多编年史">
    <button wx:for="{{campaign}}" wx:key="id" class="control act-button {{level.id === item.id ? 'act-current' : ''}}" data-id="{{item.id}}" bindtap="selectAct" disabled="{{!item.unlocked}}">
      {{item.id}}. {{item.title}}{{item.record.relicCollected ? ' · 残页' : ''}}{{item.record ? ' · ' + item.record.rank : ''}}
    </button>
  </view>
  <view class="board-caption" wx:if="{{storageFailed}}">进度暂时只保留在此页面。</view>
  <view class="board-caption" wx:elif="{{relicCollected}}">本局已找到残页。通关结算后收入编年史。</view>
  <view class="toolbar">
    <text class="turn">回合 {{turn}}</text>
    <button class="control" hover-class="pressed" bindtap="undo" disabled="{{!canUndo}}">
      <image class="ui-icon-sm" src="{{uiIcons.undo}}" mode="aspectFit" />
      <text>撤销</text>
    </button>
    <button class="control" hover-class="pressed" bindtap="reset">
      <image class="ui-icon-sm" src="{{uiIcons.reset}}" mode="aspectFit" />
      <text>重置</text>
    </button>
    <button class="control" hover-class="pressed" bindtap="toggleHints">
      <image class="ui-icon-sm" src="{{uiIcons.hint}}" mode="aspectFit" />
      <text>{{showHints ? '收起提示' : '提示'}}</text>
    </button>
  </view>

  <view class="board-frame">
    <view class="board" style="padding-bottom: {{boardRatio}}%;">
      <canvas id="game-canvas" type="2d" class="board-canvas"></canvas>
      <view class="hit-grid" bindtap="tapTile">
        <view class="hit-row" wx:for="{{rows}}" wx:for-item="row" wx:key="*this">
          <view class="hit-tile" wx:for="{{columns}}" wx:for-item="col" wx:key="*this" data-row="{{row}}" data-col="{{col}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{canvasError}}" class="panel notice">
    <text>棋盘加载失败</text>
    <button class="control" hover-class="pressed" bindtap="prepareBoard">重新加载</button>
  </view>

  <view wx:if="{{banner}}" class="banner">
    <image wx:if="{{bannerIconUri}}" class="ui-icon-sm" src="{{bannerIconUri}}" mode="aspectFit" />
    <text>{{banner}}</text>
  </view>
  <view wx:else class="board-caption">点相邻格子，或用方向键移动。</view>

  <view wx:if="{{ending && !ending.settled}}" class="panel ending">
    <view class="section-title">
      <image wx:if="{{ending.iconUri}}" class="ui-icon-md" src="{{ending.iconUri}}" mode="aspectFit" />
      <text>{{ending.title}}</text>
    </view>
    <view class="ending-description">{{ending.description}}</view>
    <view class="ending-actions">
      <button class="control" hover-class="pressed" bindtap="undo">撤销一步</button>
      <button wx:if="{{ending.won}}" class="control primary" hover-class="pressed" bindtap="settle">结算并继续</button>
      <button wx:else class="control primary" hover-class="pressed" bindtap="reset">再来一次</button>
    </view>
  </view>

  <view class="directions" wx:else>
    <button class="control direction" aria-label="向左移动" data-dx="-1" data-dy="0" hover-class="pressed" bindtap="move">←</button>
    <button class="control direction" aria-label="向上移动" data-dx="0" data-dy="-1" hover-class="pressed" bindtap="move">↑</button>
    <button class="control direction" aria-label="向下移动" data-dx="0" data-dy="1" hover-class="pressed" bindtap="move">↓</button>
    <button class="control direction" aria-label="向右移动" data-dx="1" data-dy="0" hover-class="pressed" bindtap="move">→</button>
  </view>

  <view wx:if="{{showHints}}" class="panel hints">
    <view class="section-title">
      <image class="ui-icon-sm" src="{{uiIcons.scroll}}" mode="aspectFit" />
      <text>羊皮纸启示</text>
    </view>
    <text wx:for="{{level.hints}}" wx:key="*this">{{index + 1}}. {{item}}</text>
  </view>

  <view class="panel">
    <view class="section-title">
      <image class="ui-icon-sm" src="{{uiIcons.crest}}" mode="aspectFit" />
      <text>家族馈赠</text>
    </view>
    <view wx:for="{{cards}}" wx:key="id" class="skill {{item.isActive ? 'skill-active' : ''}}">
      <image class="skill-icon-img" src="{{item.iconUri}}" mode="aspectFit" />
      <view class="skill-copy">
        <view class="skill-title">{{item.name}} · {{item.abilityName}}</view>
        <view class="skill-description">{{item.desc}}</view>
      </view>
      <text class="badge" wx:if="{{!item.unlocked}}">未相遇</text>
      <text class="badge" wx:elif="{{!item.charges}}">已用尽</text>
      <view class="badge shield" wx:elif="{{item.isPassive}}">
        <image class="ui-icon-xs" src="{{uiIcons.shield}}" mode="aspectFit" />
        <text>护盾生效</text>
      </view>
      <button wx:else class="control primary skill-button" aria-label="{{item.isActive ? '取消' : '施放'}}{{item.abilityName}}" hover-class="pressed" data-skill="{{item.id}}" disabled="{{!!ending || item.blocked}}" bindtap="useSkill">{{item.blocked ? '迷雾封印' : item.isActive ? '取消' : '施放 ' + item.charges}}</button>
    </view>
  </view>

  <view class="panel">
    <view class="section-title">
      <image class="ui-icon-sm" src="{{uiIcons.quill}}" mode="aspectFit" />
      <text>马孔多编年史</text>
    </view>
    <view>
      <view wx:for="{{logs}}" wx:key="id" class="log log-{{item.type}}">
        <text class="log-turn">T{{item.turn}}</text>
        <text>{{item.text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{preparation}}" class="loadout-overlay">
    <view class="loadout-sheet">
      <view class="section-title">{{preparation.title}}</view>
      <view class="board-caption">先祖同行 {{preparation.picked.length}} / {{preparation.slots}}</view>
      <view wx:for="{{preparation.hints}}" wx:key="flag" class="board-caption">{{item.active ? '已生效' : '待达成'}} · {{item.text}}</view>
      <scroll-view scroll-y class="loadout-choices">
        <button wx:for="{{preparation.choices}}" wx:key="id" class="control loadout-choice {{item.selected ? 'act-current' : ''}}" data-id="{{item.id}}" disabled="{{item.disabled}}" bindtap="toggleCompanion">
          <image class="skill-icon-img" src="{{item.iconUri}}" mode="aspectFit" />
          <view><text>{{item.name}} · {{item.abilityName}}</text><view class="skill-description">{{item.unlocked ? item.desc : '尚未解锁'}}</view></view>
        </button>
      </scroll-view>
      <view class="ending-actions">
        <button class="control primary" bindtap="beginAct">开始这一幕</button>
        <button class="control" bindtap="closePreparation">返回棋盘</button>
      </view>
    </view>
  </view>
</view>
